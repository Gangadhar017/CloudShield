# CloudShield Environment Configuration
PROJECT_NAME="CloudShield"
VERSION="1.0.0"
ENVIRONMENT="development"
SECRET_KEY="cloudshield-super-secret-jwt-key-replace-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with SQLite fallback)
POSTGRES_USER=cloudshield
POSTGRES_PASSWORD=shieldpass123
POSTGRES_DB=cloudshield
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./cloudshield.db
# Uncomment to use PostgreSQL directly:
# DATABASE_URL=postgresql://cloudshield:shieldpass123@localhost:5432/cloudshield

# Service Ports & Endpoints
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_URL=http://localhost:9090
TEST_APP_URL=http://localhost:8001

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
